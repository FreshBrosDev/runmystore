---
// One pricing card. Used for the three modules and (with `wide`) the bundle.
import type { Plan } from '../data/site';

interface Props {
  plan: Plan;
  /** Button label. */
  cta?: string;
  /** Horizontal layout for the bundle card. */
  wide?: boolean;
}
const { plan, cta = plan.cta ?? 'Start', wide = false } = Astro.props;
const scales = plan.variant === 'scales';
---

<article class:list={['plan', { wide, scales, recommended: plan.recommended }]} id={plan.id}>
  {plan.recommended && <span class="badge">Recommended</span>}
  <div class="head">
    <h3>{plan.name}</h3>
    {scales && plan.threshold && <p class="threshold">{plan.threshold}</p>}
    <p class="price"><b>{plan.price}</b><span>{plan.cadence}</span></p>
    {scales && plan.floor && <p class="floor">{plan.floor}</p>}
  </div>
  <div class="body">
    <p class="desc">{plan.description}</p>
    {plan.includes && (
      <ul class="includes" role="list">
        {plan.includes.map((x) => <li>{x}</li>)}
      </ul>
    )}
    {plan.disclosure && <p class="disclosure">{plan.disclosure}</p>}
    <p class="fair">{plan.fairUse}</p>
  </div>
  <a class="btn start" href={plan.startUrl}>{cta} <span class="arrow" aria-hidden="true">→</span></a>
</article>

<style>
  .plan {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 20px;
    padding: 28px;
    color: var(--text); /* the card is always white, whatever section it sits on */
    background: var(--paper);
    border: 1px solid var(--line);
    border-top: 5px solid var(--teal);
    border-radius: 6px 6px var(--radius) var(--radius);
    transition:
      transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .plan:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 40px -24px rgba(26, 26, 26, 0.35);
  }
  @media (prefers-reduced-motion: reduce) {
    .plan:hover {
      transform: none;
    }
  }
  .recommended {
    border-color: var(--ink);
    border-top-color: var(--ink);
  }
  .badge {
    position: absolute;
    top: -14px;
    left: 24px;
    padding: 5px 12px;
    font-family: var(--display);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    background: var(--ink);
    border-radius: 999px;
  }
  .head h3 {
    font-size: 1.35rem;
  }
  .price {
    margin-top: 8px;
    font-family: var(--display);
    font-style: italic;
    font-weight: 800;
    font-stretch: 112%;
    line-height: 1;
  }
  .price b {
    font-size: 2.4rem;
    letter-spacing: -0.02em;
  }
  .price span {
    margin-left: 4px;
    font-size: 1rem;
    font-weight: 700;
    color: var(--muted);
  }
  .desc {
    color: var(--text);
  }
  .disclosure {
    margin-top: 12px;
    padding-left: 14px;
    border-left: 3px solid var(--teal);
    font-size: 0.92rem;
    color: var(--muted);
  }
  .fair {
    margin-top: 12px;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .start {
    justify-self: start;
  }
  .threshold {
    margin-top: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--teal);
  }
  .floor {
    margin-top: 6px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--muted);
  }
  .scales .price span {
    display: block;
    margin-left: 0;
    margin-top: 4px;
    font-family: var(--body);
    font-style: normal;
    font-weight: 500;
    font-size: 0.95rem;
  }
  .includes {
    display: grid;
    gap: 8px;
    margin-top: 14px;
    font-size: 0.95rem;
  }
  .includes li {
    position: relative;
    padding-left: 24px;
  }
  .includes li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 14px;
    height: 4px;
    background: var(--teal);
    transform: skewX(var(--skew));
  }
  .wide {
    grid-template-columns: 1fr 1.4fr auto;
    grid-template-rows: none;
    align-items: center;
    gap: 32px;
    padding: 36px 32px;
  }
  .wide .price b {
    font-size: 2.8rem;
  }
  @media (max-width: 860px) {
    .wide {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
