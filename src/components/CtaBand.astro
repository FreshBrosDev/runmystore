---
import Stripes from './Stripes.astro';
import { bookingUrl, guarantee } from '../data/site';

interface Props {
  title?: string;
  body?: string;
}
const { title = 'Start with one module.', body = 'Or book a call and we’ll tell you which one to start with.' } = Astro.props;
---

<section class="dark band">
  <div class="wrap inner">
    <Stripes class="lg" />
    <div>
      <h2>{title}</h2>
      <p class="lede">{body}</p>
      <div class="actions">
        <a class="btn" href="/#modules">Start with one <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn ghost" href={bookingUrl} rel="noopener">Book a call</a>
      </div>
      <p class="fineprint">{guarantee}</p>
    </div>
  </div>
</section>

<style>
  .band {
    padding-block: clamp(64px, 9vw, 112px);
    overflow: hidden;
  }
  .inner {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: clamp(32px, 6vw, 88px);
  }
  h2 {
    max-width: 17ch;
  }
  .lede {
    margin-top: 20px;
  }
  .actions {
    margin-top: 32px;
  }
  .fineprint {
    margin-top: 22px;
  }
  @media (max-width: 760px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
