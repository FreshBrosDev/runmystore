---
import Logo from './Logo.astro';
import { site, contactEmail, social } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="dark">
  <div class="wrap top">
    <div>
      <Logo light height={30} />
      <p class="tag display">{site.tagline}</p>
    </div>
    <div class="contact">
      <span class="label">Contact</span>
      <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
      <span class="label">Follow</span>
      <span class="socials">
        <a href={social.youtube} rel="noopener">YouTube {social.handle}</a>
        <a href={social.instagram} rel="noopener">Instagram {social.handle}</a>
      </span>
    </div>
  </div>
  <div class="wrap base">
    <span>© {year} RunMyStore</span>
    <span class="legal">
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
    </span>
  </div>
</footer>

<style>
  footer {
    border-top: 4px solid var(--teal);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    padding-block: 56px 40px;
  }
  .tag {
    margin-top: 20px;
    font-size: 1.4rem;
    max-width: 14ch;
  }
  .contact {
    display: grid;
    gap: 6px;
  }
  .label {
    font-family: var(--display);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-dark);
  }
  .contact a {
    font-weight: 600;
    text-decoration: none;
  }
  .contact a:hover {
    text-decoration: underline;
  }
  .contact .label + .label {
    margin-top: 14px;
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }
  .base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding-block: 22px;
    border-top: 1px solid var(--ink-3);
    font-size: 0.88rem;
    color: var(--muted-dark);
  }
  .legal {
    display: flex;
    gap: 20px;
  }
  .legal a {
    text-decoration: none;
  }
  .legal a:hover {
    color: #fff;
  }
</style>
