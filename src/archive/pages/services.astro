---
import Base from '../layouts/Base.astro';
import Stripes from '../components/Stripes.astro';
import CtaBand from '../components/CtaBand.astro';
import { departments, offer, site } from '../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: departments.map((d, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: d.name,
      description: d.summary,
      provider: { '@type': 'Organization', name: site.name },
      url: `${site.url}/services/#${d.id}`,
    },
  })),
};
---

<Base
  title="The stack: six departments, one team"
  description="Storefront, SEO and content, email and SMS, wholesale pipeline, fulfillment and reporting — what RunMyStore installs and runs for alternative brands."
  schema={[schema]}
>
  <section class="dark pagehero">
    <div class="wrap">
      <p class="eyebrow"><Stripes /> The stack</p>
      <h1>Six departments. <span class="accent">Run as one.</span></h1>
      <p class="lede">
        Every problem a growing brand feels comes from a department it never had. Here’s each one we install, what goes
        in, and what changes. All six are built during your free {offer.days} days.
      </p>
      <nav class="jump" aria-label="Departments">
        {departments.map((d) => <a href={`#${d.id}`}><b>{d.num}</b> {d.name}</a>)}
      </nav>
    </div>
  </section>

  {
    departments.map((d, i) => (
      <section id={d.id} class:list={['section dept', { mist: i % 2 === 1 }]}>
        <div class="wrap row">
          <div class="reveal">
            <span class="num big">{d.num}</span>
            <h2>{d.name}</h2>
            <p class="line">{d.line}</p>
            <p class="lede">{d.summary}</p>
            {d.id === 'wholesale' && (
              <p class="deeper">
                <a class="textlink" href="/wholesale/">See the full wholesale build →</a>
              </p>
            )}
          </div>
          <div class="card reveal">
            <h3 class="eyebrow">What we install</h3>
            <ul class="checks">
              {d.installs.map((x) => <li>{x}</li>)}
            </ul>
            <div class="change">
              <span class="eyebrow">What changes</span>
              <p>{d.changes}</p>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <CtaBand title="All six, built in 30 days. Free." body="Then you decide which ones we keep running." />
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 44px;
  }
  .jump a {
    padding: 10px 16px;
    border: 1px solid var(--ink-3);
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 500;
    color: #d5dddc;
    text-decoration: none;
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .jump a:hover {
    border-color: var(--teal);
    color: #fff;
  }
  .jump b {
    margin-right: 6px;
    font-family: var(--display);
    font-style: italic;
    color: var(--teal-bright);
  }
  .row {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: start;
    gap: clamp(32px, 6vw, 96px);
  }
  .big {
    display: block;
    font-size: 1.3rem;
    margin-bottom: 18px;
  }
  .line {
    margin-top: 18px;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.3rem;
    line-height: 1.3;
    color: var(--teal-deep);
  }
  .lede {
    margin-top: 16px;
  }
  .deeper {
    margin-top: 24px;
  }
  .card {
    padding: 34px;
  }
  .card .checks {
    margin-top: 22px;
    gap: 14px;
    font-weight: 500;
  }
  .change {
    margin-top: 30px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .change p {
    margin-top: 8px;
    font-size: 1.08rem;
    font-weight: 500;
    color: var(--text);
  }
  @media (max-width: 860px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
