---
import Base from '../layouts/Base.astro';
import Stripes from '../components/Stripes.astro';
import PlanCard from '../components/PlanCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import LiveStore from '../components/LiveStore.astro';
import Logo from '../components/Logo.astro';
import { site, modules, bundle, guarantee, upperTier, howItWorks, faqs2, bookingUrl, social } from '../data/site';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs2.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const who = [
  'You’re already selling, somewhere between $3k and $15k a month, and the orders keep coming.',
  'You answer every customer email yourself, and repeat buyers slip away because nobody followed up with them.',
  'You know there are buyers out there you haven’t reached, and you never have time to go find them.',
];
---

<Base
  description="Three systems that run your store while you run your brand: customer service, retention and lead generation, $500 a month each, month to month, live in 14 days."
  schema={[faqSchema]}
>
  <!-- 1. Hero -->
  <section class="dark hero">
    <div class="wrap hero-grid">
      <div>
      <p class="eyebrow"><Stripes /> RunMyStore</p>
      <h1>You own the brand. <span class="accent">We run the store.</span></h1>
      <p class="lede">
        Three systems that run your store while you run your brand. Pick one or all three for $500 a month each,
        and we have it running in 14 days.
      </p>
      <div class="actions">
        <a class="btn" href="#modules">Start with one <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn ghost" href={bookingUrl} rel="noopener">Book a call</a>
      </div>
      <ul class="facts" role="list">
        <li><b>$500</b><span>a month, per module</span></li>
        <li><b>14 days</b><span>from paying to running</span></li>
        <li><b>$0</b><span>setup fee, cancel any month</span></li>
      </ul>
      </div>
      <LiveStore />
    </div>
  </section>

  <!-- 2. Who it's for -->
  <section class="section mist who-sec">
    <div class="wrap who-grid">
      <div class="who-head">
        <Logo height={44} />
        <h2>Who it’s for.</h2>
      </div>
      <ul class="who" role="list">
        {who.map((w) => <li>{w}</li>)}
      </ul>
    </div>
  </section>

  <!-- 3. Modules + 4. Bundle -->
  <section class="section dark" id="modules">
    <div class="wrap">
      <div class="head reveal">
        <p class="eyebrow"><Stripes /> The modules</p>
        <h2>Three systems. $500 a month each.</h2>
        <p class="lede">Month to month with no setup fee. Each one is installed, trained on your business, and run for you.</p>
      </div>
      <div class="grid g3 plans">
        {modules.map((m) => <PlanCard plan={m} />)}
      </div>
      <div class="bundle reveal">
        <PlanCard plan={bundle} wide cta="Start with all three" />
      </div>
      <p class="upper">
        {upperTier.line}{' '}
        <a class="textlink" href={bookingUrl} rel="noopener">{upperTier.cta}.</a>
      </p>
    </div>
  </section>

  <!-- 5. How it works -->
  <section class="section mist" id="how">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow"><Stripes /> How it works</p>
        <h2>Live in 14 days.</h2>
      </div>
      <ol class="steps" role="list">
        {
          howItWorks.map((s, i) => (
            <li>
              <span class="when">{s.when}</span>
              <p>{s.what}</p>
            </li>
          ))
        }
      </ol>
      <div class="monthly">
      <div>
        <p class="eyebrow"><Stripes /> What you get every month</p>
        <h2>A short daily summary. Nothing to log into.</h2>
      </div>
      <p class="lede">
        Every morning you get a short note. It tells you which conversations were handled and what was said, which
        customers were reached and who came back, which leads came in and why they fit, and anything that needs you,
        like a question the assistant couldn’t answer, a refund to approve, or a lead worth a call. It takes two
        minutes to read and then you get on with your day.
        <a class="textlink yt" href={social.youtube} rel="noopener">Watch how every piece gets built on our YouTube channel.</a>
      </p>
    </div>
    </div>
  </section>

  <!-- 7. FAQ -->
  <section class="section dark" id="faq">
    <div class="wrap">
      <div class="head reveal">
        <p class="eyebrow"><Stripes /> Questions</p>
        <h2>Straight answers.</h2>
      </div>
      <Faq items={faqs2} />
    </div>
  </section>

  <!-- 8. Final CTA -->
  <CtaBand />
</Base>

<style>
  .yt {
    display: block;
    margin-top: 16px;
  }

  .hero {
    padding-block: clamp(36px, 5vw, 64px) clamp(48px, 7vw, 88px);
    background: radial-gradient(900px 500px at 85% 0%, rgba(13, 115, 119, 0.22), transparent 60%), var(--ink);
  }
  /* Teal on charcoal is 3.1:1: fine for display-size headings, never for body text. */
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: start;
    gap: clamp(32px, 5vw, 72px);
  }
  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }
  .hero h1 {
    margin-top: 22px;
    max-width: 14ch;
  }
  .hero h1 .accent {
    display: block;
    color: var(--teal);
  }
  .hero .lede {
    margin-top: 24px;
    max-width: 48ch;
    font-weight: 500;
    color: #fff;
  }
  .hero .actions {
    margin-top: 36px;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 36px;
    margin-top: 34px;
    padding-top: 24px;
    border-top: 1px solid var(--ink-3);
  }
  .facts li {
    display: grid;
    gap: 2px;
  }
  .facts b {
    font-family: var(--display);
    font-style: italic;
    font-weight: 800;
    font-stretch: 112%;
    font-size: 1.7rem;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .facts span {
    font-size: 0.9rem;
    color: var(--muted-dark);
  }

  .who-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    align-items: start;
    gap: clamp(28px, 5vw, 72px);
  }
  .who-head {
    display: grid;
    gap: 22px;
    justify-items: start;
  }
  .who-head h2 {
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
  }
  .who {
    display: grid;
    gap: 22px;
    font-size: clamp(1.25rem, 1.9vw, 1.55rem);
    font-weight: 600;
    line-height: 1.4;
    color: var(--text);
    letter-spacing: -0.01em;
  }
  .who li {
    position: relative;
    padding-left: 40px;
  }
  .who li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.6em;
    width: 22px;
    height: 5px;
    background: var(--teal);
    transform: skewX(var(--skew));
  }
  @media (max-width: 860px) {
    .who-grid {
      grid-template-columns: 1fr;
    }
  }

  .plans {
    align-items: stretch;
  }
  .bundle {
    margin-top: 36px;
  }
  .upper {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--ink-3);
    color: var(--muted-dark);
  }
  .upper .textlink {
    margin-left: 8px;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    border-top: 4px solid var(--ink);
  }
  .steps li {
    padding: 28px 28px 8px 0;
  }
  .steps li + li {
    padding-left: 28px;
    border-left: 1px solid #cfcfcf;
  }
  .when {
    display: block;
    margin-bottom: 12px;
    font-family: var(--display);
    font-style: italic;
    font-weight: 800;
    font-size: 1.4rem;
    color: var(--teal);
  }
  .steps p {
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .steps {
      grid-template-columns: 1fr;
    }
    .steps li,
    .steps li + li {
      padding: 22px 0;
      border-left: 0;
      border-bottom: 1px solid #cfcfcf;
    }
  }

  .monthly {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: clamp(28px, 5vw, 72px);
    margin-top: clamp(48px, 6vw, 80px);
    padding-top: clamp(40px, 5vw, 64px);
    border-top: 4px solid var(--ink);
  }
  .monthly h2 {
    margin-top: 20px;
  }
  @media (max-width: 800px) {
    .monthly {
      grid-template-columns: 1fr;
    }
  }
</style>
