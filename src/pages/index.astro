---
import Base from '../layouts/Base.astro';
import Stripes from '../components/Stripes.astro';
import PlanCard from '../components/PlanCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import LiveStore from '../components/LiveStore.astro';
import { site, modules, bundle, guarantee, upperTier, howItWorks, faqs2, bookingUrl } from '../data/site';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs2.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const who = [
  'You’re already selling — roughly $3k to $15k a month — and the orders keep coming.',
  'You answer every customer email yourself, and repeat buyers slip away because nobody followed up.',
  'You know there are buyers you haven’t reached, and there’s no time to go find them.',
];
---

<Base
  description="Three systems that run your store while you run your brand: customer service, retention and lead generation, $500 a month each, month to month, live in 14 days."
  schema={[faqSchema]}
>
  <!-- 1. Hero -->
  <section class="dark hero">
    <div class="wrap hero-grid">
      <div>
      <p class="eyebrow"><Stripes /> RunMyStore</p>
      <h1>You own the brand. <span class="accent">We run the store.</span></h1>
      <p class="lede">
        Three systems that run your store while you run your brand. Pick one or all three. $500 a month each. Live in
        14 days.
      </p>
      <div class="actions">
        <a class="btn" href="#modules">Start with one <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn ghost" href={bookingUrl} rel="noopener">Book a call</a>
      </div>
      <p class="fineprint">{guarantee}</p>
      </div>
      <LiveStore />
    </div>
  </section>

  <!-- 2. Who it's for -->
  <section class="section tight">
    <div class="wrap">
      <p class="eyebrow"><Stripes /> Who it’s for</p>
      <ul class="who" role="list">
        {who.map((w) => <li>{w}</li>)}
      </ul>
    </div>
  </section>

  <!-- 3. Modules + 4. Bundle -->
  <section class="section mist" id="modules">
    <div class="wrap">
      <div class="head reveal">
        <p class="eyebrow"><Stripes /> The modules</p>
        <h2>Three systems. $500 a month each.</h2>
        <p class="lede">Month to month. No setup fee. Each one is installed, trained on your business, and run for you.</p>
      </div>
      <div class="grid g3 plans">
        {modules.map((m) => <PlanCard plan={m} />)}
      </div>
      <div class="bundle reveal">
        <PlanCard plan={bundle} wide cta="Start with all three" />
      </div>
      <p class="upper">
        {upperTier.line}
        <a class="textlink" href={bookingUrl} rel="noopener">{upperTier.cta} →</a>
      </p>
    </div>
  </section>

  <!-- 5. How it works -->
  <section class="section dark" id="how">
    <div class="wrap">
      <div class="head reveal">
        <p class="eyebrow"><Stripes /> How it works</p>
        <h2>Live in 14 days.</h2>
      </div>
      <ol class="steps" role="list">
        {
          howItWorks.map((s, i) => (
            <li class="reveal" style={`transition-delay:${i * 80}ms`}>
              <span class="when">{s.when}</span>
              <p>{s.what}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 6. What you get every month -->
  <section class="section">
    <div class="wrap monthly reveal">
      <div>
        <p class="eyebrow"><Stripes /> What you get every month</p>
        <h2>A short daily summary. Nothing to log into.</h2>
      </div>
      <p class="lede">
        Every day you get a short summary: the conversations handled and what was said, the customers reached and who
        came back, the leads delivered and why they fit, and anything that needs you — a question the assistant
        couldn’t answer, a refund to approve, a lead worth a call. Read it in two minutes and get on with your day.
      </p>
    </div>
  </section>

  <!-- 7. FAQ -->
  <section class="section mist" id="faq">
    <div class="wrap">
      <div class="head reveal">
        <p class="eyebrow"><Stripes /> Questions</p>
        <h2>Straight answers.</h2>
      </div>
      <Faq items={faqs2} />
    </div>
  </section>

  <!-- 8. Final CTA -->
  <CtaBand />
</Base>

<style>
  .hero {
    padding-block: clamp(56px, 9vw, 120px) clamp(48px, 7vw, 88px);
    background: radial-gradient(900px 500px at 85% 0%, rgba(13, 115, 119, 0.22), transparent 60%), var(--ink);
  }
  /* Teal on charcoal is 3.1:1: fine for display-size headings, never for body text. */
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(40px, 6vw, 88px);
  }
  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }
  .hero h1 {
    margin-top: 22px;
    max-width: 14ch;
  }
  .hero h1 .accent {
    display: block;
    color: var(--teal);
  }
  .hero .lede {
    margin-top: 24px;
    max-width: 48ch;
    font-weight: 500;
    color: #fff;
  }
  .hero .actions {
    margin-top: 36px;
  }
  .hero .fineprint {
    margin-top: 22px;
  }

  .who {
    display: grid;
    gap: 14px;
    margin-top: 22px;
    max-width: 62ch;
    font-size: 1.1rem;
    line-height: 1.5;
  }
  .who li {
    position: relative;
    padding-left: 30px;
  }
  .who li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 16px;
    height: 4px;
    background: var(--teal);
    transform: skewX(var(--skew));
  }

  .plans {
    align-items: stretch;
  }
  .bundle {
    margin-top: 36px;
  }
  .upper {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }
  .upper .textlink {
    margin-left: 8px;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    border-top: 1px solid var(--ink-3);
  }
  .steps li {
    padding: 28px 28px 8px 0;
  }
  .steps li + li {
    padding-left: 28px;
    border-left: 1px solid var(--ink-3);
  }
  .when {
    display: block;
    margin-bottom: 12px;
    font-family: var(--display);
    font-style: italic;
    font-weight: 800;
    font-size: 1.4rem;
  }
  .steps p {
    color: var(--muted-dark);
  }
  @media (max-width: 860px) {
    .steps {
      grid-template-columns: 1fr;
    }
    .steps li,
    .steps li + li {
      padding: 22px 0;
      border-left: 0;
      border-bottom: 1px solid var(--ink-3);
    }
  }

  .monthly {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: clamp(28px, 5vw, 72px);
  }
  .monthly h2 {
    margin-top: 20px;
  }
  @media (max-width: 800px) {
    .monthly {
      grid-template-columns: 1fr;
    }
  }
</style>
