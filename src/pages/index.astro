---
import Base from '../layouts/Base.astro';
import Stripes from '../components/Stripes.astro';
import PlanCard from '../components/PlanCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import LiveStore from '../components/LiveStore.astro';
import Logo from '../components/Logo.astro';
import { modules, pro, customBuild, guarantee, howItWorks, faqs2, bookingUrl, social, categoryTiles, pains } from '../data/site';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs2.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

---

<Base
  description="Three systems that run your store while you run your brand: customer service, retention and lead generation, $500 a month each, month to month, live in 14 days."
  schema={[faqSchema]}
>
  <!-- 1. Hero -->
  <section class="dark hero">
    <div class="wrap hero-grid">
      <div>
      <p class="eyebrow"><Stripes /> RunMyStore</p>
      <h1>You own the brand. <span class="accent">We run the store.</span></h1>
      <p class="lede">
        We run customer service, retention, and the back office for brands in categories the big platforms won’t
        serve. From $500 a month. Live in 14 days.
      </p>
      <div class="actions">
        <a class="btn" href="#modules">Start with one <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn ghost" href={bookingUrl} rel="noopener">Book a call</a>
      </div>
      <ul class="facts" role="list">
        <li><b>$500</b><span>a month to start</span></li>
        <li><b>14 days</b><span>from paying to running</span></li>
        <li><b>$0</b><span>setup fee, cancel any month</span></li>
      </ul>
      </div>
      <LiveStore />
    </div>
  </section>

  <!-- 2. Who we serve -->
  <section class="section mist who-sec" id="who">
    <div class="wrap">
      <div class="who-head">
        <Logo height={44} />
        <h2>Who we serve.</h2>
        <p class="lede">Brands in the categories the big platforms won’t touch. Tap one to see what we set up for it.</p>
      </div>

      <div class="tiles" data-tiles>
        {
          categoryTiles.map((t) => (
            <button class="tile" type="button" aria-pressed="false">
              <span class="tile-name">{t.name}</span>
              <span class="tile-setup">{t.setup}</span>
              <span class="tile-plus" aria-hidden="true">+</span>
            </button>
          ))
        }
      </div>

      <div class="pains">
        <p class="pains-label">Sound familiar?</p>
        <ul role="list">
          {pains.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- 3. Self-serve plans + 4. Pro -->
  <section class="section dark" id="modules">
    <div class="wrap">
      <div class="head reveal">
        <p class="eyebrow"><Stripes /> Self-serve</p>
        <h2>Pick a plan. Live in 14 days.</h2>
        <p class="lede">Month to month with no setup fee. A dedicated operator is included on every plan.</p>
      </div>
      <div class="grid g2 plans">
        {modules.map((m) => <PlanCard plan={m} />)}
      </div>

      <div class="pro reveal">
        <PlanCard plan={pro} wide />
      </div>
      <p class="custom">
        {customBuild.line}{' '}
        <a class="textlink" href={bookingUrl} rel="noopener">{customBuild.cta}.</a>
      </p>
    </div>
  </section>

  <!-- 5. How it works -->
  <section class="section mist" id="how">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow"><Stripes /> How it works</p>
        <h2>From paying to live in 14 days.</h2>
      </div>
      <ol class="steps" role="list">
        {
          howItWorks.map((s, i) => (
            <li>
              <span class="when">{s.when}</span>
              <p>{s.what}</p>
            </li>
          ))
        }
      </ol>
      <div class="monthly">
      <div>
        <p class="eyebrow"><Stripes /> What you get every month</p>
        <h2>A short daily summary. Nothing to log into.</h2>
      </div>
      <p class="lede">
        Every morning you get a short note. It tells you which conversations were handled and what was said, which
        customers were reached and who came back, and anything that needs you, like a question the assistant
        couldn’t answer or a refund to approve. It takes two
        minutes to read and then you get on with your day. On Run the Store Pro you also get your numbers in one
        email every week.
        <a class="textlink yt" href={social.youtube} rel="noopener">Watch how every piece gets built on our YouTube channel.</a>
      </p>
    </div>
    </div>
  </section>

  <!-- 7. FAQ -->
  <section class="section dark" id="faq">
    <div class="wrap">
      <div class="head reveal">
        <p class="eyebrow"><Stripes /> Questions</p>
        <h2>Straight answers.</h2>
      </div>
      <Faq items={faqs2} />
    </div>
  </section>

  <!-- 8. Final CTA -->
  <CtaBand />
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-tiles] .tile').forEach((b) =>
    b.addEventListener('click', () => b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'))),
  );
</script>

<style>
  .yt {
    display: block;
    margin-top: 16px;
  }

  .hero {
    padding-block: clamp(36px, 5vw, 64px) clamp(48px, 7vw, 88px);
    background: radial-gradient(900px 500px at 85% 0%, rgba(13, 115, 119, 0.22), transparent 60%), var(--ink);
  }
  /* Teal on charcoal is 3.1:1: fine for display-size headings, never for body text. */
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: start;
    gap: clamp(32px, 5vw, 72px);
  }
  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }
  .hero h1 {
    margin-top: 22px;
    max-width: 14ch;
  }
  .hero h1 .accent {
    display: block;
    color: var(--teal);
  }
  .hero .lede {
    margin-top: 24px;
    max-width: 48ch;
    font-weight: 500;
    color: #fff;
  }
  .hero .actions {
    margin-top: 36px;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 36px;
    margin-top: 34px;
    padding-top: 24px;
    border-top: 1px solid var(--ink-3);
  }
  .facts li {
    display: grid;
    gap: 2px;
  }
  .facts b {
    font-family: var(--display);
    font-style: italic;
    font-weight: 800;
    font-stretch: 112%;
    font-size: 1.7rem;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .facts span {
    font-size: 0.9rem;
    color: var(--muted-dark);
  }

  .who-head {
    display: grid;
    gap: 18px;
    justify-items: start;
    max-width: 60ch;
  }
  .who-head h2 {
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-top: 40px;
  }
  .tile {
    position: relative;
    display: grid;
    align-content: start;
    gap: 10px;
    min-height: 150px;
    padding: 22px 48px 22px 24px;
    text-align: left;
    font: inherit;
    color: var(--text);
    background: var(--paper);
    border: 1px solid transparent;
    border-left: 5px solid var(--teal);
    border-radius: 6px var(--radius) var(--radius) 6px;
    cursor: pointer;
    transition:
      transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1),
      background 0.2s;
  }
  .tile:hover,
  .tile:focus-visible,
  .tile[aria-pressed='true'] {
    transform: translateY(-4px);
    box-shadow: 0 24px 40px -24px rgba(26, 26, 26, 0.4);
  }
  .tile[aria-pressed='true'] {
    background: var(--ink);
    color: #fff;
    border-left-color: var(--teal);
  }
  .tile-name {
    font-family: var(--display);
    font-weight: 700;
    font-stretch: 105%;
    font-size: 1.2rem;
    line-height: 1.2;
  }
  .tile-setup {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--muted);
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.25s ease,
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .tile:hover .tile-setup,
  .tile:focus-visible .tile-setup,
  .tile[aria-pressed='true'] .tile-setup {
    opacity: 1;
    transform: none;
  }
  .tile[aria-pressed='true'] .tile-setup {
    color: rgba(255, 255, 255, 0.86);
  }
  .tile-plus {
    position: absolute;
    top: 16px;
    right: 18px;
    font-size: 1.5rem;
    line-height: 1;
    font-weight: 500;
    color: var(--teal);
    transition: transform 0.25s ease;
  }
  .tile[aria-pressed='true'] .tile-plus {
    transform: rotate(45deg);
    color: #fff;
  }
  .pains {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 16px 32px;
    margin-top: 36px;
    padding-top: 28px;
    border-top: 1px solid #cfcfcf;
  }
  .pains-label {
    font-family: var(--display);
    font-style: italic;
    font-weight: 800;
    font-size: 1.4rem;
    white-space: nowrap;
  }
  .pains ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 14px;
  }
  .pains li {
    padding: 10px 16px 10px 36px;
    position: relative;
    font-weight: 600;
    background: var(--paper);
    border-radius: 999px;
  }
  .pains li::before {
    content: '';
    position: absolute;
    left: 14px;
    top: 50%;
    width: 14px;
    height: 4px;
    margin-top: -2px;
    background: var(--teal);
    transform: skewX(var(--skew));
  }
  @media (max-width: 900px) {
    .tiles {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .tiles {
      grid-template-columns: 1fr;
    }
    .tile {
      min-height: 0;
    }
    .pains {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tile,
    .tile-setup,
    .tile-plus {
      transition: none;
    }
    .tile:hover {
      transform: none;
    }
  }

  .plans {
    align-items: stretch;
  }
  .pro {
    margin-top: 36px;
  }
  .custom {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--ink-3);
    color: var(--muted-dark);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    border-top: 4px solid var(--ink);
  }
  .steps li {
    padding: 28px 28px 8px 0;
  }
  .steps li + li {
    padding-left: 28px;
    border-left: 1px solid #cfcfcf;
  }
  .when {
    display: block;
    margin-bottom: 12px;
    font-family: var(--display);
    font-style: italic;
    font-weight: 800;
    font-size: 1.4rem;
    color: var(--teal);
  }
  .steps p {
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .steps {
      grid-template-columns: 1fr;
    }
    .steps li,
    .steps li + li {
      padding: 22px 0;
      border-left: 0;
      border-bottom: 1px solid #cfcfcf;
    }
  }

  .monthly {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: clamp(28px, 5vw, 72px);
    margin-top: clamp(48px, 6vw, 80px);
    padding-top: clamp(40px, 5vw, 64px);
    border-top: 4px solid var(--ink);
  }
  .monthly h2 {
    margin-top: 20px;
  }
  @media (max-width: 800px) {
    .monthly {
      grid-template-columns: 1fr;
    }
  }
</style>
