---
import Base from '../layouts/Base.astro';
import Stripes from '../components/Stripes.astro';
---

<Base title="Page not found">
  <section class="dark pagehero">
    <div class="wrap">
      <p class="eyebrow"><Stripes /> 404</p>
      <h1>That page isn’t in stock.</h1>
      <p class="lede">It moved, or it never existed. Here’s the way back.</p>
      <div class="actions">
        <a class="btn" href="/">Back to the homepage <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn ghost" href="/services/">See the stack</a>
      </div>
    </div>
  </section>
</Base>
