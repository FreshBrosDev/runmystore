# All optional. Every URL has a working fallback (see src/data/site.ts).

# Scheduling link for "Book a call". Fallback: WhatsApp.
PUBLIC_BOOKING_URL=

# Checkout / start links for the two self-serve plans. Fallback: a mailto to PUBLIC_CONTACT_EMAIL with the plan in the subject.
# Run the Store Pro and custom builds use PUBLIC_BOOKING_URL.
PUBLIC_START_URL_CUSTOMER_SERVICE=
PUBLIC_START_URL_RUN_THE_STORE=

# Footer social links. Fallbacks point at @LaunchRMS.
PUBLIC_YOUTUBE_URL=
PUBLIC_INSTAGRAM_URL=

# Shown in the footer and used by the mailto fallbacks.
PUBLIC_CONTACT_EMAIL=

# Legacy: endpoint for the archived application form (src/archive/pages/apply.astro).
PUBLIC_LEAD_ENDPOINT=
